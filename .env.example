# Database
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
DATABASE_URL=postgresql+asyncpg://myastro:CHANGE_ME_strong_password_here@db:5432/myastro
DATABASE_URL_SYNC=postgresql://myastro:CHANGE_ME_strong_password_here@db:5432/myastro

# Redis
REDIS_PASSWORD=CHANGE_ME_redis_password_here
REDIS_URL=redis://:CHANGE_ME_redis_password_here@redis:6379/0

# JWT - CRITICAL: Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_MUST_BE_RANDOM
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# PII Encryption - CRITICAL: Generate with: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_MUST_BE_RANDOM_ENCRYPTION_KEY

# --- AI Provider Configuration ---
# OpenRouter (recommended - supports 100+ models):
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_API_KEY=sk-or-v1-your-openrouter-key
#
# Direct OpenAI:
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_API_KEY=sk-your-openai-key
#
# Local Ollama (free, for testing):
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_API_KEY=ollama
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-v1-your-key-here

# Models per subscription tier (OpenRouter format: provider/model)
# Change these anytime without code changes!
# Free models: openai/gpt-4o-mini, google/gemini-flash-1.5, meta-llama/llama-3.1-8b-instruct
# Premium models: openai/gpt-4o, anthropic/claude-sonnet-4, google/gemini-pro-1.5
AI_MODEL_FREE=openai/gpt-4o-mini
AI_MODEL_PREMIUM=openai/gpt-4o

# AI generation params
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.8

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Google OAuth (optional for MVP)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App settings
APP_NAME=MyAstro
APP_VERSION=0.1.0
# SECURITY: Set to false in production. When true, enables dev-login and debug endpoints.
DEBUG=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Rate limiting
HOROSCOPE_DAILY_LIMIT_FREE=3
HOROSCOPE_DAILY_LIMIT_PREMIUM=20
HOROSCOPE_HISTORY_SIZE=5

# Family members
FAMILY_MEMBERS_LIMIT_FREE=0
FAMILY_MEMBERS_LIMIT_PREMIUM=5

# Ad verification
AD_VIEW_TOKEN_TTL_SECONDS=300
