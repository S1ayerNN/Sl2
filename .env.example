# Database
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
DATABASE_URL=postgresql+asyncpg://myastro:CHANGE_ME_strong_password_here@db:5432/myastro
DATABASE_URL_SYNC=postgresql://myastro:CHANGE_ME_strong_password_here@db:5432/myastro

# Redis
REDIS_PASSWORD=CHANGE_ME_redis_password_here
REDIS_URL=redis://:CHANGE_ME_redis_password_here@redis:6379/0

# JWT - CRITICAL: Generate a strong random key (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=CHANGE_ME_MUST_BE_RANDOM
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# App
APP_NAME=MyAstro
APP_VERSION=0.1.0
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
